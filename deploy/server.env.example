# Runtime config for the EC2 server — copy to server/.env on the box (chmod 600).
# NEVER commit the real file. The systemd unit loads it via EnvironmentFile.

DATABASE_URL=postgresql://postgres:<strong-password>@localhost:5432/trio?schema=public
JWT_SECRET=<at-least-16-chars>
JWT_EXPIRES_IN=7d

# CloudFront domains of the two SPAs (client2 + admin), comma-separated
CORS_ORIGIN=https://app.example.com,https://admin.example.com
LOG_LEVEL=info

# Media bucket (runtime uploads — server/src/lib/storage.ts)
S3_REGION=<media-bucket-region>
S3_BUCKET=<media-bucket>
S3_ACCESS_KEY_ID=<key>
S3_SECRET_ACCESS_KEY=<secret>
S3_FORCE_PATH_STYLE=false
